# SkyNest Robiul — environment template
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so NEVER put a real secret here.
#
#   cp .env.example .env.local
#
# Every name below is read in lib/env.js or lib/site.js. Nothing else is.

# ──────────────────────────────────────────────────────────────────────
# Required
# ──────────────────────────────────────────────────────────────────────

# Mongo connection string. Local mongod or an Atlas SRV URI.
MONGODB_URI=mongodb://127.0.0.1:27017/skynest

# Optional: override the database name inside the URI.
# MONGODB_DB=skynest

# Signing key for the admin session JWT. Minimum 32 characters, and it MUST
# differ between development and production — a shared secret means a dev
# token unlocks the live panel. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ──────────────────────────────────────────────────────────────────────
# Public site identity  (NEXT_PUBLIC_* is shipped to the browser)
# ──────────────────────────────────────────────────────────────────────

# The real origin, with protocol and no trailing slash. This is NOT cosmetic:
# sitemap.xml, robots.txt, canonical links, JSON-LD @ids and Open Graph URLs
# are all built from it. Left at localhost in production, robots.txt will
# disallow the whole site on purpose (see app/robots.js).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Display form, e.g. +880 1XXX-XXXXXX
NEXT_PUBLIC_PHONE=+880 1715-339599

# Digits only, country code included — wa.me requires this shape.
NEXT_PUBLIC_WHATSAPP=8801715339599

NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_ADDRESS_LINE=শেওড়াপাড়া, ঢাকা
NEXT_PUBLIC_ADDRESS_LINE_EN=Shewrapara, Dhaka, Bangladesh
NEXT_PUBLIC_MAP_URL=

NEXT_PUBLIC_FACEBOOK=
NEXT_PUBLIC_YOUTUBE=
NEXT_PUBLIC_INSTAGRAM=

# ──────────────────────────────────────────────────────────────────────
# Mail  (optional — the site degrades gracefully without it)
# ──────────────────────────────────────────────────────────────────────
#
# With these unset, an inquiry is still saved and the visitor still sees the
# success screen; only the notification email is skipped, and the admin inbox
# records it as "skipped" rather than failing the request.
#
# Gmail needs an App Password, not the account password.
# Check the whole path with:  npm run verify-mail

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Where inquiry notifications land. Defaults to SMTP_USER.
ADMIN_EMAIL=

# From header. Defaults to "SkyNest Robiul <SMTP_USER>".
MAIL_FROM=

# ──────────────────────────────────────────────────────────────────────
# Uploads & misc  (defaults are fine)
# ──────────────────────────────────────────────────────────────────────

# UPLOAD_DIR=public/uploads
# UPLOAD_URL_PREFIX=/uploads
# MAX_UPLOAD_MB=12
# AUTH_SESSION_MAX_AGE=28800

# Seeds demo photographs from Pexels. Only used by `npm run seed`.
PEXELS_API_KEY=

# Set to true to expose /styleguide in a production build. Off by default.
ENABLE_STYLEGUIDE=
