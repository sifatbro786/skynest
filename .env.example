# ---------------------------------------------------------------
# Copy to .env.local for development, and to .env on the VPS.
# Never commit the filled-in file.
# ---------------------------------------------------------------

# Database ------------------------------------------------------
MONGODB_URI="mongodb://127.0.0.1:27017/skynestrobiul"
# Optional: override the database name encoded in the URI
# MONGODB_DB="skynestrobiul"

# Admin auth ----------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Session lifetime in seconds (default 8 hours)
AUTH_SESSION_MAX_AGE="28800"

# Uploads (VPS local disk — no external CDN) --------------------
UPLOAD_DIR="public/uploads"
UPLOAD_URL_PREFIX="/uploads"
MAX_UPLOAD_MB="12"

# Public site details ------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Display form — shown on the site
NEXT_PUBLIC_PHONE="+880 1715-339599"
# Digits only with country code — required by wa.me
NEXT_PUBLIC_WHATSAPP="8801715339599"
NEXT_PUBLIC_EMAIL=""
NEXT_PUBLIC_ADDRESS_LINE="শেওড়াপাড়া, ঢাকা"
NEXT_PUBLIC_ADDRESS_LINE_EN="Shewrapara, Dhaka, Bangladesh"
NEXT_PUBLIC_MAP_URL=""
NEXT_PUBLIC_FACEBOOK=""
NEXT_PUBLIC_YOUTUBE=""
NEXT_PUBLIC_INSTAGRAM=""
